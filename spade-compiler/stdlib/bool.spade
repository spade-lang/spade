impl bool {
    /// Returns `Some(t)` if the `bool` is `true`, or `None` otherwise.
    ///
    /// # Examples
    ///
    /// ```spade
    /// assert false.then_some(67u8) == None;
    /// assert true.then_some(67u8) == Some(67u8);
    /// ```
    pub fn then_some<T>(self, t: T) -> Option<T> {
        if self {
            Some(t)
        } else {
            None
        }
    }
}
