/// Trait for types which have a constructible default value.
pub trait Default {
    fn default() -> Self;
}

impl Default for bool {
    fn default() -> Self {
        false
    }
}

impl Default for () {
    fn default() -> Self { () }
}

impl<T0: Default> Default for (T0) {
    fn default() -> Self {
        (T0::default())
    }
}

impl<T0: Default, T1: Default> Default for (T0, T1) {
    fn default() -> Self {
        (T0::default(), T1::default())
    }
}

impl<T0: Default, T1: Default, T2: Default> Default for (T0, T1, T2) {
    fn default() -> Self {
        (T0::default(), T1::default(), T2::default())
    }
}

impl<T0: Default, T1: Default, T2: Default, T3: Default> Default for (T0, T1, T2, T3) {
    fn default() -> Self {
        (T0::default(), T1::default(), T2::default(), T3::default())
    }
}

impl<T0: Default, T1: Default, T2: Default, T3: Default, T4: Default> Default for (T0, T1, T2, T3, T4) {
    fn default() -> Self {
        (T0::default(), T1::default(), T2::default(), T3::default(), T4::default())
    }
}

impl<T0: Default, T1: Default, T2: Default, T3: Default, T4: Default, T5: Default> Default for (T0, T1, T2, T3, T4, T5) {
    fn default() -> Self {
        (T0::default(), T1::default(), T2::default(), T3::default(), T4::default(), T5::default())
    }
}

impl<T0: Default, T1: Default, T2: Default, T3: Default, T4: Default, T5: Default, T6: Default> Default for (T0, T1, T2, T3, T4, T5, T6) {
    fn default() -> Self {
        (T0::default(), T1::default(), T2::default(), T3::default(), T4::default(), T5::default(), T6::default())
    }
}

impl<T0: Default, T1: Default, T2: Default, T3: Default, T4: Default, T5: Default, T6: Default, T7: Default> Default for (T0, T1, T2, T3, T4, T5, T6, T7) {
    fn default() -> Self {
        (T0::default(), T1::default(), T2::default(), T3::default(), T4::default(), T5::default(), T6::default(), T7::default())
    }
}

/// Builds a default value for a type implementing the `Default` trait.
///
/// This is a short hack for types with generics, as `MyStruct::<A>::default()` is
/// currently not supported by spade.
///
/// # Examples
///
/// ```spade
/// let zero: uint<8> = default();
/// let none: Option<bool> = default();
/// assert zero == 0;
/// assert none == None;
/// ```
pub fn default<T: Default>() -> T {
    T::default()
}
