pub use core::mem::{Ro, Wo};

use lib::cdc as cdc;

/// Define a memory where values are written on the rising edge of the clock.
/// Reads can occur asynchronously with the `read_mem` function. If Clocked reads
/// should be used, the read result should be placed in a register
///
/// The write array defines all the write ports to the memory. It consists of a
/// `write enable`, `address` and `data` field. When WE is enabled, data is written
/// to address. Otherwise no change takes effect
/// NOTE: We when possible, we should make compute AddrWidth from NumElements
#[deprecated = "Use a `memory` declaration instead"]
pub extern entity clocked_memory<#uint NumElements, #uint WritePorts, #uint AddrWidth, D>(
    clk: clock,
    writes: [(bool, uint<AddrWidth>, D); WritePorts],
) -> Memory<D, NumElements>;


/// Same as `clocked_memory` but initializes the memory with the values specified in `initial_values`.
/// The initial values must be evaluatable at compile time, otherwise an error is thrown
#[deprecated = "Use a `memory` declaration instead"]
pub extern entity clocked_memory_init<#uint NumElements, #uint WritePorts, #uint AddrWidth, D>(
    clk: clock,
    writes: [(bool, uint<AddrWidth>, D); WritePorts],
    initial_values: [D; NumElements]
) -> Memory<D, NumElements>;

/// Get the value out of a memory
pub extern entity read_memory<#uint AddrWidth, D, #uint NumElements> (
    mem: Memory<D, NumElements>,
    addr: uint<AddrWidth>
) -> D;


pub struct WritePort<#uint W, D> {
    addr: inv uint<W>,
    write: inv Option<D>,
}

impl<#uint W, D> WritePort<W, D> {
    pub fn write(self, addr: uint<W>, write: Option<D>) {
        let WritePort { addr: saddr, write: swrite } = self;
        set saddr = addr;
        set swrite = write;
    }
}


/// A read port for a memory. It is not recommended to manually read the signals
/// in this struct, instead use `.read()` to access the port.
pub struct ReadPort<#uint W, D> {
    addr: inv uint<W>,
    out: D,
}

impl<#uint W, D> ReadPort<W, D> {
    /// Read the value stored at `addr`
    pub pipeline(1) read(wire self, read_clk: clock, addr: uint<W>) -> D {
        let ReadPort(wire saddr, wire sout) = self;
        set saddr = addr;
    reg;
        sout
    }
}

/// Read a read port. Deprecated, prefer using the `ReadPort::read()` method instead
#[deprecated = "Use `Ro<T, N, L>::read` instead"]
pub pipeline(1) read_read_port<#uint W, D>(read_clk: clock, addr: uint<W>, wire p: ReadPort<W, D>) -> D {
    let result = p.inst(1) read(read_clk, addr);
reg;
    result
}

/// A dual port block RAM that supports read and write ports being in different domains.
/// If writes and reads happen to the same address, the behaviour is undefined.
#[deprecated = "Use `std::mem::simple_dual_port_ram` instead"]
pub entity dp_bram<#uint W, D, #uint C>(write_clk: clock, read_clk: clock) -> (WritePort<W, D>, ReadPort<W, D>) {
    memory: [D; C] {
        read_port: Ro<_, _, 1>,
        write_port: Wo<_, _, 1>,
    };

    let write_addr = port();
    let write_data = port();

    let write_req = match write_data.0 {
        None => None,
        Some(data) => Some((write_addr.0, data)),
    };

    write_port.write(write_clk, write_req);

    let read_addr = port();
    let read_data = read_port.inst(1) read(read_clk, Some(read_addr.0));

    (
        WritePort {
            addr: write_addr.1,
            write: write_data.1,
        },
        ReadPort {
            addr: read_addr.1,
            out: read_data.unwrap_or_undef(),
        },
    )
}

/// A dual port block RAM that supports read and write ports being in different domains.
/// If writes and reads happen to the same address, the behaviour is undefined.
pub entity simple_dual_port_ram<T, #uint N>() -> (Ro<T, N, 1>, Wo<T, N, 1>) {
    memory: [T; N] {
        read_port: Ro<_, _, 1>,
        write_port: Wo<_, _, 1>,
    };

    (read_port, write_port)
}

/// A fifo write port. Writes a single element of data data in to the write port unless `full`
/// is true. If full is true, the write is ignored
pub struct FifoWrite<D> {
    write: inv Option<D>,
    full: bool,
}

/// A fifo read port
/// If there fifo is not empty, `read` contains the next value. If ack is set,
/// that element is popped from the fifo this clock cycle. / The num_elements
/// is approximate but guaranteed to be a conservative estimate, i.e. there are
/// at least `num_elements` in the fifo.
pub struct FifoRead<#uint W, D> {
    read: Option<D>,
    ack: inv bool,
    num_elements: uint<W>
}

mod fifo_impl {
    use lib::cdc as cdc;

    use lib::mem::FifoRead;
    use lib::mem::FifoWrite;
    use lib::mem::Ro;
    use lib::mem::Wo;

    struct FifoRtoW<#uint W> {
        read_ptr: uint<W>,
        write_ptr: inv uint<W>,
    }

    pub(super) entity fifo_read<D, #uint C>(
        read_clk: clock,
        read_rst: bool,
        mem: Ro<D, C, 1>,
        to_w: inv FifoRtoW<{uint::bits_for(C - 1)}>,
        write_clk: clock
    ) -> FifoRead<{uint::bits_for(C - 1)}, D> {
        // Synchronization stuff
        let write_ptr = unsafe {
            inst lib::cdc::sync_uint_counter(
                source_clk: write_clk,
                dest_clk: read_clk,
                input: to_w.write_ptr,
            )
        };
        let write_clk = false; // Unbind write_clk so we don't use it on accident later

        let ack = port();

        decl read_ptr;
        let empty = write_ptr == read_ptr;
        let read_ptr_next = match (ack.0, empty) {
            (true, true) => read_ptr,
            (true, false) => trunc(read_ptr + 1),
            (false, _) => read_ptr,
        };
        reg(read_clk) read_ptr reset(read_rst: 0) = read_ptr_next;

        let out = mem.inst(1) read(read_clk, Some(read_ptr_next)).unwrap_or_undef();

        let num_elements = {
            // If write is behind read, it is catching up
            // |-----w--------r--------|
            // So add the size of the memory to the write ptr to make
            // |--------------r--------|-----w-----------------|
            // now (w - r) is positive and < C

            // The + 0 here is a manual zext
            let write_ptr_abs = if write_ptr < read_ptr {write_ptr + 0 + C} else {zext(write_ptr)};

            trunc((write_ptr_abs - zext(read_ptr)))
        };

        set to_w.read_ptr = read_ptr;

        FifoRead {
            read: if !empty { Some(out) } else { None },
            ack: ack.1,
            num_elements: num_elements,
        }
    }

    pub(super) entity fifo_write<D, #uint C>(
        write_clk: clock,
        write_rst: bool,
        mem: Wo<D, C, 1>,
        from_w: FifoRtoW<{uint::bits_for(C - 1)}>,
        read_clk: clock
    ) -> FifoWrite<D> {
        let read_ptr = unsafe {
            inst cdc::sync_uint_counter(
                source_clk: read_clk,
                dest_clk: write_clk,
                input: from_w.read_ptr,
            )
        };
        let read_clk = false; // Unbind so we don't use it on accident later

        let write_value = port();

        decl write_ptr;
        let full = trunc(write_ptr + 1) == read_ptr;

        reg(write_clk) write_ptr reset(write_rst: 0) = match (write_value.0, full) {
            (Some(v), false) => trunc(write_ptr + 1),
            _ => write_ptr,
        };

        let req = match (write_value.0, full) {
            (Some(v), false) => Some((write_ptr, v)),
            _ => None,
        };

        mem.write(write_clk, req);

        set from_w.write_ptr = write_ptr;
        FifoWrite {
            full: full,
            write: write_value.1
        }
    }
}

/// A cross-domain fifo backed by block RAM.
pub entity fifo<Data, #uint NumElements>(
    write_clk: clock,
    write_rst: bool,
    read_clk: clock,
    read_rst: bool,
) -> (FifoWrite<Data>, FifoRead<{uint::bits_for(NumElements - 1)}, Data>)
where NumElements == 1 << uint::bits_for(NumElements - 1) else "Number of elements must be a power of two"
{
    let (read_port, write_port) = inst simple_dual_port_ram::<Data, NumElements>();

    let (from_w, to_w) = port();

    let write = inst fifo_impl::fifo_write::<Data, NumElements>(write_clk:, write_rst:, mem: write_port, from_w:, read_clk:);
    let read = inst fifo_impl::fifo_read::<Data, NumElements>(read_clk:, read_rst:, mem: read_port, to_w:, write_clk:);

    (write, read)
}
