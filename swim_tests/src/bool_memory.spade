entity test(clk: clock, addr: uint<16>, we: bool, write: bool) -> bool {
    memory: [bool; 65_536] {
        read_port: std::mem::Ro<_, _, 0>,
        write_port: std::mem::Wo<_, _, 1>,
    };

    let write_req = if we { Some((addr, write)) } else { None };
    write_port.write(clk, write_req);
    read_port.read_comb(Some(addr)).unwrap_or_undef()
}
