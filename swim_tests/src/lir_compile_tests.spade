struct S {
    b: inv int<8>,
}

entity small_set_if(a: bool, b: inv int<8>, c: int<8>) {
    set b = if a { c } else { c };
}

entity simple_inspect(a: inv bool) -> bool {
    set a = true;
    *a.inspect()
}

entity simple_match(x: [uint<2>; 2]) -> bool {
    match x {
        [0, 0] => true,
        _ => false,
    }
}


