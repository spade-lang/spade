entity sync(clk: clk, signal: bool) -> bool {
    reg(clk) out = signal;
    out
}

entity posedge_detector(clk: clk, signal: bool) -> bool {
    reg(clk) prev = signal;
    signal && (if prev {false} else {true})
}

enum TxState {
    // 00
    Waiting,
    // 01
    Transmit(
        // Number of clock cycles since the last bit was sent
        last_bit: int<10>,
        num_transmitted: int<3>,
        data: int<8>
    ),
    // 10
    LastCycle(time: int<10>, value: bool),
    // 11
    WaitForNext(time: int<10>, value: bool),
}

enum TxExternalState {
    Ready,
    TransmitStart,
    Transmitting,
    TransmitDone,
}

// SPI transmitter module. Frequency is fixed to 1 MHz. If no bit is being
// transmitted and to_transmit is Some(val), val will be transmitted.
// Otherwise, to_transmit is ignored.
// Return value is (sclk, mosi, waiting)
entity spi_tx(clk: clk, rst: bool, to_transmit: Option<int<8>>) ->
    (bool, bool, TxExternalState)
{
    reg(clk) state reset (rst: TxState::Waiting()) = {
        match state {
            TxState::Waiting => {
                match to_transmit {
                    Option::Some(val) => TxState::Transmit(0, 0, val),
                    Option::None => TxState::Waiting()
                }
            },
            TxState::Transmit(last_bit, num_transmitted, data) => {
                let sclk_op = last_bit == 50;
                let new_last_bit = last_bit + 1;

                if sclk_op {
                    if num_transmitted == 7 {
                        TxState::LastCycle(0, (data & 1) == 1)
                    }
                    else {
                        TxState::Transmit(new_last_bit, num_transmitted + 1, data >> 1)
                    }
                }
                else if last_bit == 99 {
                    TxState::Transmit(0, num_transmitted, data)
                }
                else {
                    TxState::Transmit(new_last_bit, num_transmitted, data)
                }
            },
            TxState::LastCycle(time, val) => {
                if time == 49 {
                    // TxState::Waiting()
                    TxState::WaitForNext(0, val)
                }
                else {
                    TxState::LastCycle(time + 1, val)
                }
            },
            TxState::WaitForNext(time, val) => {
                if time == 100 {
                    TxState::Waiting()
                }
                else {
                    TxState::WaitForNext(time+1, val)
                }
            }
        }
    };

    match state {
        TxState::Waiting() => (true, true, TxExternalState::Ready()),
        TxState::Transmit(last_bit, num_transmitted, data) => {
            let state = if last_bit == 0 && num_transmitted == 0 {
                TxExternalState::TransmitStart()
            }
            else {
                TxExternalState::Transmitting()
            };
            ((last_bit < 50), (data & 1) == 1, state)
        },
        TxState::LastCycle(time, val) => {
            let external_state = if time == 49 {
                TxExternalState::TransmitDone()
            }
            else {
                TxExternalState::Transmitting()
            };
            (false, val, external_state)
        },
        TxState::WaitForNext(_, val) => {
            (true, val, TxExternalState::Transmitting())
        }
    }
}

