enum DisplayState {
    // Unitialised and has been for x cycles
    Uninit(duration: int<21>),
    // Chip select held high without data being transmitted
    PreTransmit(duration: int<8>),
    // Currently transmitting the header for the start of a line
    TransmitLineHeader(line: int<8>),
    TransmitLineNumber(line: int<8>),
    // Currently transmitting the pixels of line `line`. The pixels being transmitted are
    // col..col+8
    TransmitPixels(line: int<8>, col: int<8>),
    // Transmitting the padding betwene lines
    InterLinePadding(line: int<8>),
    // Transmitting the final padding at the end of the frame
    EndOfFramePadding,
    EndOfFrameWaitSpi,
    // Keeping chip select high until display is ready
    EndOfFrameWait(duration: int<21>)
}

enum DisplayOutput {
    // No output, chip select low
    None,
    CsHigh,
    // Send display command
    Command(val: int<8>),
    LineNumber(line: int<8>),
    // Send pixel data
    Pixel(line: int<8>, col: int<8>, pixels: int<8>),
    Padding
}

// Return chip select, display output
entity display_fsm(clk: clk, rst: bool, spi_tx_state: TxExternalState) -> (bool, DisplayOutput) {
    // On sequence duration. Doing 1 ms just to be on the safe side
    let on_time = 100_000;
    // Chip select hold time. (clock cycles for  (2 us @ 100MHz))
    let thSCS = 200;
    // Chip select low time. (clock cycles for (6 us @ 100MHz))
    // For debugging this is set higher
    let twSCSL = 600;

    // We need to switch vcom around occationally to refresh the display
    reg(clk) (vcom, vcom_counter): (int<8>, int<11>) reset (rst: (0, 0)) = {
        if vcom_counter == 1000 {
            (if vcom == 0 {0x40} else {0}, 0)
        }
        else {
            (vcom, vcom_counter+1)
        }
    };

    // 240/8
    let col_count = 50;
    let line_count = 240;
    reg(clk) state reset (rst: DisplayState::Uninit(0)) = {
        match (spi_tx_state, state) {
            (_, DisplayState::Uninit(duration)) => {
                if duration > on_time {
                    DisplayState::PreTransmit(0)
                }
                else {
                    DisplayState::Uninit(duration+1)
                }
            },
            (_, DisplayState::PreTransmit(duration)) => {
                if duration > thSCS {
                    DisplayState::TransmitLineHeader(0)
                }
                else {
                    DisplayState::PreTransmit(duration+1)
                }
            },
            (TxExternalState::TransmitStart, DisplayState::TransmitLineHeader(line)) => {
                DisplayState::TransmitLineNumber(line)
            },
            (TxExternalState::TransmitStart, DisplayState::TransmitLineNumber(line)) => {
                DisplayState::TransmitPixels(line, 0)
            },
            (TxExternalState::TransmitStart, DisplayState::TransmitPixels(line, col)) => {
                if col > col_count-1 {
                    DisplayState::InterLinePadding(line)
                }
                else {
                    DisplayState::TransmitPixels(line, col+1)
                }
            },
            (TxExternalState::TransmitStart, DisplayState::InterLinePadding(line)) => {
                if line > line_count-1 {
                    DisplayState::EndOfFramePadding()
                }
                else {
                    DisplayState::TransmitLineNumber(line+1)
                    // DisplayState::EndOfFramePadding()
                }
            },
            (TxExternalState::TransmitStart, DisplayState::EndOfFramePadding) => {
                DisplayState::EndOfFrameWaitSpi()
            },
            (TxExternalState::TransmitDone, DisplayState::EndOfFrameWaitSpi) => {
                DisplayState::EndOfFrameWait(0)
            },
            (_, DisplayState::EndOfFrameWait(duration)) => {
                if duration > twSCSL {
                    DisplayState::PreTransmit(0)
                }
                else {
                    DisplayState::EndOfFrameWait(duration+1)
                }
            },
            (_, _) => state,
        }
    };

    let cs = match state {
        DisplayState::Uninit(_) => false,
        DisplayState::PreTransmit(_) => true,
        DisplayState::TransmitLineHeader(_) => true,
        DisplayState::TransmitLineNumber(_) => true,
        DisplayState::TransmitPixels(_, _) => true,
        // Transmitting the padding betwene lines
        DisplayState::InterLinePadding(_) => true,
        // Transmitting the final padding at the end of the frame
        DisplayState::EndOfFramePadding => true,
        // Keeping chip select high until display is ready
        DisplayState::EndOfFrameWaitSpi => true,
        DisplayState::EndOfFrameWait(_) => false,
    };

    let output = match state {
        DisplayState::Uninit(_) => DisplayOutput::None(),
        DisplayState::PreTransmit(_) => DisplayOutput::None(),
        DisplayState::TransmitLineHeader(_) => DisplayOutput::Command(0x80 | vcom),
        DisplayState::TransmitLineNumber(line) => DisplayOutput::LineNumber$(line),
        DisplayState::TransmitPixels(line, col) => DisplayOutput::Pixel$(col, line, pixels: 0),
        // Transmitting the padding betwene lines
        DisplayState::InterLinePadding(_) => DisplayOutput::Padding(),
        // Transmitting the final padding at the end of the frame
        DisplayState::EndOfFramePadding => DisplayOutput::Padding(),
        DisplayState::EndOfFrameWaitSpi => DisplayOutput::None(),
        // Keeping chip select high until display is ready
        DisplayState::EndOfFrameWait(_) => DisplayOutput::None()
    };

    (cs, output)
}

entity display_spi_command(output: DisplayOutput) -> Option<int<8>> {
    match output {
        DisplayOutput::None() => Option::None(),
        DisplayOutput::Command(cmd) => Option::Some(cmd),
        DisplayOutput::LineNumber(num) => Option::Some(num),
        DisplayOutput::Pixel(_, _, pixels) => Option::Some(pixels),
        DisplayOutput::Padding() => Option::Some(0)
    }
}
