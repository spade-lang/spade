fn p<#N, #M>(x: int<N..M>) -> int<N..M> { x }

fn f(a: int<5>) -> int<7> {
  1 * p(a) + 1
}

entity main(clk: clock, rst: bool) -> int<7> {
  f(3)
}


error: Argument type mismatch
  ┌─ testinput:8:5
