entity test<'a, 'b>(clk: clock, a: 'a bool, b: 'b bool) {
    reg(clk) x = (true, (a, b));
}


error: A value in the ('const, ('a, 'b)) domain cannot be stored in a register.
  ┌─ testinput:2:18
  │
2 │     reg(clk) x = (true, (a, b));
  │                  ^^^^^^^^^^^^^^ ('const, ('a, 'b)) in a register
  │
  = help: Values stored in registers must have a clock
  = note: Tuples can only be stored in registers if all elements have a common domain
